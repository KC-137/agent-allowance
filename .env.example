# NEAR TESTNET ONLY. Never put mainnet keys here. Never commit this file once filled in (.env is git-ignored).
CONTRACT_ID=contract-YOURNAME.testnet
OWNER_ID=owner-YOURNAME.testnet
AGENT_ID=agent-YOURNAME.testnet
GUARDIAN_ID=guardian-YOURNAME.testnet
PAYEE_ID=vendor-YOURNAME.testnet
ATTACKER_ID=attacker-YOURNAME.testnet
NEWVENDOR_ID=newvendor-YOURNAME.testnet
OWNER_KEY=ed25519:PASTE_PRIVATE_KEY
CONTRACT_KEY=ed25519:PASTE_PRIVATE_KEY
AGENT_KEY=ed25519:PASTE_PRIVATE_KEY
GUARDIAN_KEY=ed25519:PASTE_PRIVATE_KEY
# Second approver (testnet account), used by demo-approvals.mjs and review.mjs --as=approver2
APPROVER2_ID=approver2-YOURNAME.testnet
APPROVER2_KEY=ed25519:PASTE_PRIVATE_KEY
NEAR_RPC=https://test.rpc.fastnear.com

# ---- Free-tier AI providers (any subset works; more = more resilient). Empty = skipped. ----
# Order the chain tries them:
AI_PROVIDERS=gemini,groq,cloudflare,openrouter
GEMINI_API_KEY=            # aistudio.google.com
GROQ_API_KEY=              # console.groq.com
CF_ACCOUNT_ID=             # Cloudflare dashboard: Workers AI
CF_API_TOKEN=
OPENROUTER_API_KEY=        # openrouter.ai/keys (only ":free" models from known vendors are used)
# Optional model overrides if a default is retired (leave unset normally):
# GEMINI_MODEL=
# GROQ_MODEL=
# CF_MODEL=
# OPENROUTER_MODEL=
# Max screened requests per day that may call AI (protects free-tier quotas)
AI_DAILY_BUDGET=40
# Per-request timeout in ms (raise if Gemini is slow under load)
AI_TIMEOUT_MS=15000
# 1 = skip the AI when the free rules already block (saves quota, but the demo then shows "rules" for the injection step)
AI_SAVE_CALLS=0
